+.club[data-rim="double"] .rr { display: inline; stroke: var(--rim); stroke-width: .42; r: 2.38px; }
+.club[data-rim="half"] .t-h:not(.gk) .mag, .club[data-rim="buoy"] .t-h:not(.gk) .mag { stroke: none; }
