+.club[data-rim="half"] .rr, .club[data-rim="buoy"] .rr { display: inline; stroke: var(--rim); stroke-width: .6; }
+.club[data-rim="half"] .rr { stroke-dasharray: 6.2832 6.2832; stroke-dashoffset: 6.2832; }
+.club[data-rim="buoy"] .rr { stroke-dasharray: 3.1416 3.1416; stroke-dashoffset: 1.5708; }
